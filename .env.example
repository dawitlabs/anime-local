# Absolute path or a path relative to this repository.
MEDIA_DIR=./media
HOST=127.0.0.1
PORT=4173
CACHE_DIR=./.cache/streams
CACHE_MAX_MB=512
TRANSCODE_WORKERS=2
TORRENT_DIR=./data/torrents
# Combined declared size of all added sources; cached pieces persist until removed.
TORRENT_MAX_GB=20
# Optional comma-separated hostnames (localhost and numeric IPs already work).
ALLOWED_HOSTS=
# To watch on other devices on your trusted home network, use HOST=0.0.0.0.
# This personal server has no account system. Do not expose it to the internet.

# Automatic anime discovery; no account/API key required with these defaults.
CATALOG_URL=https://anime-kitsu.strem.fun
SOURCES_URL=https://torrentio.strem.fun
